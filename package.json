{
  "name": "nextshopid",
  "version": "1.0.0",
  "private": true,
  "description": "NextShopID Root Workspace",
  "homepage": "https://github.com/NewX-Team/NextShopID#readme",
  "bugs": {
    "url": "https://github.com/NewX-Team/NextShopID/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NewX-Team/NextShopID.git"
  },
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "init": "node scripts/init.js",
    "dev": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "concurrently \"npm run build:backend\" \"npm run build:frontend\"",
    "build:backend": "npm run build --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "start": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run start:backend\" \"npm run start:frontend\"",
    "start:backend": "npm run start --prefix backend",
    "start:frontend": "npm run start --prefix frontend",
    "test": "npm run tests",
    "tests": "npm run tests:backend",
    "tests:backend": "npm run test --prefix backend",
    "tests:frontend": "echo [NextShopID] Frontend tests not configured yet"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
