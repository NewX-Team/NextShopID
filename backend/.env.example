# Server Port
PORT=5000
NODE_ENV=development

# JWT Secret Key
JWT_SECRET=nextshopid_super_secret_jwt_key_2026
JWT_EXPIRES_IN=7d

# Client Application URL (untuk tautan reset password)
FRONTEND_URL=http://localhost:3000

# Mail Driver Configuration ('log' atau 'smtp')
MAIL_MAILER=log
MAIL_LOG_PATH=logs/mail.log

# SMTP Server Configuration (Hanya aktif jika MAIL_MAILER=smtp)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_password
MAIL_FROM_NAME=NextShopID
MAIL_FROM_ADDRESS=no-reply@nextshopid.com
